r   <- simular(C)
teo <- erlang_c(C, TASA_LLEGADA, TASA_SERVICIO)
teoria <- function(k) if (is.null(teo)) "  inestable" else sprintf("%10.3f", teo[[k]])
cat("\n*** SIMULACIÓN TERMINADA ***\n")
