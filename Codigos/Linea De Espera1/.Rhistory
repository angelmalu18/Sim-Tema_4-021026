}
list(
nc = nc, t = t,
n_llegadas = n_llegadas, n_salidas = n_salidas,
wq  = if (n_inicio > 0) suma_espera / n_inicio else 0,
w   = if (n_inicio > 0) (suma_espera + suma_servicio) / n_inicio else 0,
lq  = if (t > 0) area_cola / t else 0,
rho = if (t > 0) area_ocupados / (nc * t) else 0
)
}
