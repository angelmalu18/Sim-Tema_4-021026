cola_sv <- cola_sv[-1]
}
if (n_salidas %% CADA == 0 && n_salidas < MAX_ATENDIDOS) {
cat(sprintf("  t = %8.1f h | atendidos: %4d | en fila: %2d | Wq parcial: %.3f\n",
t, n_salidas, length(cola_ll), suma_espera / n_inicio))
}
}
}
list(
nc = nc, t = t,
n_llegadas = n_llegadas, n_salidas = n_salidas,
wq  = if (n_inicio > 0) suma_espera / n_inicio else 0,
w   = if (n_inicio > 0) (suma_espera + suma_servicio) / n_inicio else 0,
lq  = if (t > 0) area_cola / t else 0,
rho = if (t > 0) area_ocupados / (nc * t) else 0
)
}
# ------------------------------------------------------------------------------
# EJECUCIÓN E INFORME EN CONSOLA
# ------------------------------------------------------------------------------
cat("================================================================\n")
cat(" LÍNEA DE ESPERA 1 - UN SERVIDOR (M/M/1)  |  Relojería\n")
cat("================================================================\n")
cat(sprintf(" lambda = %.2f   mu = %.2f  (por hora)   servidores = %d\n",
TASA_LLEGADA, TASA_SERVICIO, C))
cat(sprintf(" Terminación: >= %d atendidos y sistema vacío\n\n", MAX_ATENDIDOS))
cat("Avance de la simulación:\n")
r   <- simular(C)
teo <- erlang_c(C, TASA_LLEGADA, TASA_SERVICIO)
teoria <- function(k) if (is.null(teo)) "  inestable" else sprintf("%10.3f", teo[[k]])
cat("\n*** SIMULACIÓN TERMINADA ***\n")
cat(sprintf("Clientes llegados: %d   atendidos: %d   tiempo simulado: %.1f horas\n\n",
r$n_llegadas, r$n_salidas, r$t))
cat(sprintf("%-22s %12s %12s\n", "Medida", "Simulación", "Teoría"))
cat(sprintf("%-22s %12.3f %12s\n", "Wq espera en fila",     r$wq,  teoria("Wq")))
cat(sprintf("%-22s %12.3f %12s\n", "W  tiempo en sistema",  r$w,   teoria("W")))
cat(sprintf("%-22s %12.3f %12s\n", "Lq en fila (prom.)",    r$lq,  teoria("Lq")))
cat(sprintf("%-22s %12.3f %12s\n", "rho utilización",       r$rho, teoria("rho")))
cat("\nUnidad de tiempo: horas\n")
