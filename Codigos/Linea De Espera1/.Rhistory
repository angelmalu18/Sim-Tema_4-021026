# ------------------------------------------------------------------------------
# CONFIGURACIÓN
# ------------------------------------------------------------------------------
TASA_LLEGADA  <- 2.0     # lambda = clientes por hora
TASA_SERVICIO <- 2.5     # mu     = clientes por hora
C             <- 1       # número de servidores
MAX_ATENDIDOS <- 800
SEMILLA       <- NULL    # NULL = distinta en cada ejecución; ej. 42 para repetir
CADA          <- 200     # cada cuántos atendidos se imprime un avance
if (!is.null(SEMILLA)) set.seed(SEMILLA)
# ------------------------------------------------------------------------------
# GENERADOR EXPONENCIAL (transformada inversa: X = -ln(1 - U) / tasa)
# ------------------------------------------------------------------------------
exponencial <- function(tasa) -log(1 - runif(1)) / tasa
# ------------------------------------------------------------------------------
# TEORÍA M/M/c (Erlang C). Para c = 1 se reduce a M/M/1.
# Devuelve NULL si el sistema es inestable (rho >= 1).
# ------------------------------------------------------------------------------
erlang_c <- function(nc, tasa_ll, tasa_sv) {
a   <- tasa_ll / tasa_sv
rho <- a / nc
if (rho >= 1) return(NULL)
suma   <- sum(a^(0:(nc - 1)) / factorial(0:(nc - 1)))
ultimo <- a^nc / (factorial(nc) * (1 - rho))
prob_esperar <- ultimo / (suma + ultimo)
lq <- prob_esperar * rho / (1 - rho)
wq <- lq / tasa_ll
list(Wq = wq, W = wq + 1 / tasa_sv, Lq = lq, rho = rho)
}
# ------------------------------------------------------------------------------
# SIMULACIÓN DE EVENTOS DISCRETOS
# ------------------------------------------------------------------------------
simular <- function(nc) {
t          <- 0
ultimo     <- 0
sig_llegada <- exponencial(TASA_LLEGADA)
fin        <- rep(Inf, nc)          # instante de fin de servicio (Inf = libre)
cola_ll    <- numeric(0)           # llegada de cada cliente en fila
cola_sv    <- numeric(0)           # duración de servicio de cada cliente en fila
n_llegadas <- 0; n_inicio <- 0; n_salidas <- 0
suma_espera <- 0; suma_servicio <- 0
area_cola <- 0; area_ocupados <- 0
avances <- NULL
iniciar <- function(llegada, servicio, k, t) {
suma_espera   <<- suma_espera + (t - llegada)
suma_servicio <<- suma_servicio + servicio
n_inicio      <<- n_inicio + 1
fin[k]        <<- t + servicio
}
repeat {
ocupados <- sum(is.finite(fin))
# Condición de terminación
if (n_salidas >= MAX_ATENDIDOS && length(cola_ll) == 0 && ocupados == 0) break
k    <- which.min(fin)
t_ev <- min(sig_llegada, fin[k])
# Acumular áreas bajo Lq y utilización
dt            <- t_ev - ultimo
area_cola     <- area_cola + length(cola_ll) * dt
area_ocupados <- area_ocupados + ocupados * dt
ultimo        <- t_ev
t             <- t_ev
if (sig_llegada <= fin[k]) {
# ---- Llegada ----
servicio   <- exponencial(TASA_SERVICIO)
n_llegadas <- n_llegadas + 1
libres     <- which(is.infinite(fin))
if (length(libres) > 0) {
iniciar(t, servicio, libres[1], t)
} else {
cola_ll <- c(cola_ll, t)
cola_sv <- c(cola_sv, servicio)
}
sig_llegada <- t + exponencial(TASA_LLEGADA)
} else {
# ---- Fin de servicio ----
fin[k]    <- Inf
n_salidas <- n_salidas + 1
if (length(cola_ll) > 0) {
iniciar(cola_ll[1], cola_sv[1], k, t)
cola_ll <- cola_ll[-1]
cola_sv <- cola_sv[-1]
}
if (n_salidas %% CADA == 0 && n_salidas < MAX_ATENDIDOS) {
cat(sprintf("  t = %8.1f h | atendidos: %4d | en fila: %2d | Wq parcial: %.3f\n",
t, n_salidas, length(cola_ll), suma_espera / n_inicio))
}
}
}
list(
nc = nc, t = t,
n_llegadas = n_llegadas, n_salidas = n_salidas,
wq  = if (n_inicio > 0) suma_espera / n_inicio else 0,
w   = if (n_inicio > 0) (suma_espera + suma_servicio) / n_inicio else 0,
lq  = if (t > 0) area_cola / t else 0,
rho = if (t > 0) area_ocupados / (nc * t) else 0
)
}
# ------------------------------------------------------------------------------
# EJECUCIÓN E INFORME EN CONSOLA
# ------------------------------------------------------------------------------
cat("================================================================\n")
cat(" LÍNEA DE ESPERA 1 - UN SERVIDOR (M/M/1)  |  Relojería\n")
cat("================================================================\n")
cat(sprintf(" lambda = %.2f   mu = %.2f  (por hora)   servidores = %d\n",
TASA_LLEGADA, TASA_SERVICIO, C))
cat(sprintf(" Terminación: >= %d atendidos y sistema vacío\n\n", MAX_ATENDIDOS))
cat("Avance de la simulación:\n")
